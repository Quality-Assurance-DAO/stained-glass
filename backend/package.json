{
  "name": "stained-glass-backend",
  "version": "1.0.0",
  "description": "Backend API for Stained Glass Window Tracking App",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "tsx scripts/seed-test-data.ts",
    "verify:openai": "tsx scripts/verify-openai.ts",
    "test:ai": "tsx scripts/test-ai-service.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "arweave": "^1.14.4",
    "@emurgo/cardano-serialization-lib-nodejs": "^11.2.0",
    "openai": "^6.9.1",
    "sharp": "^0.33.1",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
