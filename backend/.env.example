# Database Configuration
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For local development, you can use:
# - Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/stained_glass
# - Supabase: postgresql://postgres:[password]@[host]:5432/postgres
# - Neon: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stained_glass

# Server Configuration
# Port for the backend API server
PORT=3000

# Node environment: development, production, or test
NODE_ENV=development

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Arweave Configuration
# Path to Arweave wallet JSON file (optional for local development with mocks)
# ARWEAVE_WALLET_PATH=./wallets/arweave-wallet.json

# Arweave gateway URL
ARWEAVE_GATEWAY=https://arweave.net

# Cardano Configuration
# Network: testnet or mainnet
CARDANO_NETWORK=testnet

# Cardano node URL
CARDANO_NODE_URL=https://testnet.cardano.org

# AI/ML Configuration
# OpenAI API key for image analysis (optional for local development)
# OPENAI_API_KEY=sk-...

# JWT Configuration
# Secret key for JWT token signing (optional, generate a random string)
# JWT_SECRET=your-secret-key-here
